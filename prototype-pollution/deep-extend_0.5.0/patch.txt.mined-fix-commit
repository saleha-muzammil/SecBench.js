Date: Wed, 21 Mar 2018 23:25:55 +0300
Subject: [PATCH] Avoid using deprecated Buffer API

Use Buffer.alloc when it's available instead of 'new Bufer(number)'

Refs:
https://nodejs.org/api/deprecations.html#deprecations_dep0005_buffer_constructor
---
 lib/deep-extend.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/deep-extend.js b/lib/deep-extend.js
index d6cd8f9..0269a77 100644
--- a/lib/deep-extend.js
+++ b/lib/deep-extend.js
@@ -37,7 +37,9 @@ function isSpecificValue(val) {
 
 function cloneSpecificValue(val) {
 	if (val instanceof Buffer) {
-		var x = new Buffer(val.length);
+		var x = Buffer.alloc
+			? Buffer.alloc(val.length)
+			: new Buffer(val.length);
 		val.copy(x);
 		return x;
 	} else if (val instanceof Date) {
