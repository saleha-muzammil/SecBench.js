           echo "       Building anyway would silently use the default branch, which is" >&2; \
           echo "       neither locutus@2.0.11 nor the pinned commit, so the exploit" >&2; \
           echo "       oracle would be measuring the wrong code." >&2; \
           echo "       Fix the version/commit for locutus in repositories.csv, or" >&2; \
           echo "       regenerate with --allow-npm-fallback to install from npm." >&2; \
           exit 1; \
       fi \
    && node -e 'const fs=require("fs"),p=require("path"),want=process.argv[1],seen=[];const scan=(d,n)=>{if(n>3)return false;let E;try{E=fs.readdirSync(d,{withFileTypes:true})}catch(e){return false}for(const e of E){if(e.name==="node_modules"||e.name[0]===".")continue;const f=p.join(d,e.name);if(e.isFile()&&e.name==="package.json"){try{const x=JSON.parse(fs.readFileSync(f,"utf8")).name;if(x)seen.push(x);if(x===want)return true}catch(_){}}else if(e.isDirectory()&&scan(f,n+1))return true}return false};if(!scan(".",0)){console.error("ERROR: this checkout does not contain the package \"" + want + "\". package.json names found: " + (seen.slice(0,8).join(", ")||"(none)"));console.error("       repositories.csv maps it to kvz/locutus, and fix_commit_sha comes from that same row, so BOTH are wrong together. Correct the row before building.");process.exit(1)}' "locutus" \
    && for L in package-lock.json npm-shrinkwrap.json; do \
           [ -f "$L" ] || continue; \
           if grep -o "\"resolved\": *\"https\?://[^/\"]*" "$L" | sed "s|.*//||" | grep -qv "^registry\.npmjs\.org"; then \
               echo "WARNING: $L pins dependencies to a registry that is not registry.npmjs.org; removing it so npm resolves publicly" >&2; \
               rm -f "$L"; \
           fi; \
