# Benchmark metadata (package.json) + jest test case
COPY . .

RUN git clone https://github.com/kvz/locutus.git node_modules/locutus \
    && cd node_modules/locutus \
    && if ! (git checkout -q "v2.0.11" || git checkout -q "2.0.11"); then \
