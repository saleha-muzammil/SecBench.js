 lib/stat.js                  | 66 ++++++++++++++++++++------
 lib/stat.test.js             | 89 ++++++++++++++++++++++++++++--------
 package.json                 |  2 +-
 readme.md                    | 10 +++-
 5 files changed, 150 insertions(+), 34 deletions(-)
 create mode 100644 lib/hackerone-864354.test.js

diff --git a/lib/hackerone-864354.test.js b/lib/hackerone-864354.test.js
new file mode 100644
index 0000000..50a27aa
--- /dev/null
+++ b/lib/hackerone-864354.test.js
@@ -0,0 +1,17 @@
+const diskstats = require('./stat');
+
+const test = (done) => {
+	let instance = diskstats();
+
+	instance.check('; touch HACKED', (err, results) => {}).catch((err) => {
+		let str = err.toString();
+
+		expect(str.indexOf('No such file or directory')).not.toEqual(-1);
+
+		done();
+	});
+}
+
+describe("A disk stat provider", () => {
+	it("protects against attach 864354", test);
+});
