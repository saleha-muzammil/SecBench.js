9Z03ODTqrD62bN91yLJdjXv/APIpkjCVEwAA' \
    | base64 -d | gzip -dc > /exploit/utils.js

RUN git clone https://github.com/mholt/PapaParse.git node_modules/papaparse \
    && cd node_modules/papaparse \
    && if ! (git checkout -q "235a12758cd77266d2e98fd715f53536b34ad621" || { git fetch -q --depth 1 origin "235a12758cd77266d2e98fd715f53536b34ad621" && git checkout -q FETCH_HEAD; } || git checkout -q "v5.2.0" || git checkout -q "5.2.0"); then \
           echo "ERROR: cannot check out commit 235a12758c / tag v5.2.0 in https://github.com/mholt/PapaParse." >&2; \
           echo "       Building anyway would silently use the default branch, which is" >&2; \
           echo "       neither papaparse@5.2.0 nor the pinned commit, so the exploit" >&2; \
           echo "       oracle would be measuring the wrong code." >&2; \
           echo "       Fix the version/commit for papaparse in repositories.csv, or" >&2; \
           echo "       regenerate with --allow-npm-fallback to install from npm." >&2; \
           exit 1; \
       fi \
    && npm install --no-audit --no-fund --ignore-scripts \
    && (npm run build --if-present || echo "WARNING: build step failed/partial; continuing") \
    && (npm run prepare --if-present || echo "WARNING: prepare step failed/partial; continuing")

# jest installed globally so it does not disturb the package tree
# jest pinned to 29: jest 30 calls os.availableParallelism(), which the node:16 base
# image does not have, so the exploit oracle died at config load instead of running.
RUN npm install -g --no-audit --no-fund jest@29

CMD ["jest", "--runInBand"]
